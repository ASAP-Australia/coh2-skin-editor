{
  "name": "coh2-skin-editor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "publish-skin": "python3 tools/publish.py",
    "test-export": "npx tsx tools/test-export.ts",
    "electron:compile": "tsc -p tsconfig.electron.json && echo '{\"type\":\"commonjs\"}' > dist-electron/package.json",
    "electron:dev": "npm run electron:compile && concurrently \"vite\" \"wait-on http://localhost:5173 && NODE_ENV=development electron .\"",
    "electron:build": "tsc -b && ELECTRON_BUILD=1 vite build && npm run electron:compile && electron-builder",
    "electron:build:win": "tsc -b && cross-env ELECTRON_BUILD=1 vite build && npm run electron:compile && electron-builder --win"
  },
  "build": {
    "appId": "com.asap-australia.coh2-skin-editor",
    "productName": "CoH2 Skin Editor",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/steamworks.js/**/*",
      "steam_appid.txt"
    ],
    "extraResources": [
      {
        "from": "steam_appid.txt",
        "to": "../steam_appid.txt"
      }
    ],
    "asarUnpack": [
      "node_modules/steamworks.js/dist/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "public/asap-logo.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/asap-logo.png",
      "category": "Game"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/asap-logo.png"
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@types/three": "^0.184.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "pako": "^2.1.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "steamworks.js": "^0.4.0",
    "tailwind-merge": "^3.5.0",
    "three": "^0.184.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^24.12.2",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "canvas": "^3.2.3",
    "concurrently": "^9.2.1",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fast-check": "^4.8.0",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "shadcn": "^4.6.0",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.5"
  }
}
