{
  "name": "coh2-skin-editor",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:size": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "publish-skin": "python3 tools/publish.py",
    "test-export": "npx tsx tools/test-export.ts",
    "electron:compile": "tsc -p tsconfig.electron.json && echo '{\"type\":\"commonjs\"}' > dist-electron/package.json && cp electron/audit-renderer.html dist-electron/audit-renderer.html",
    "electron:dev": "npm run electron:compile && concurrently \"vite\" \"wait-on http://localhost:5173 && NODE_ENV=development electron --remote-debugging-port=9222 .\"",
    "audit:capture": "npm run electron:compile && AUDIT_CAPTURE=1 electron .",
    "audit:faithful": "npm run electron:compile && AUDIT_CAPTURE=1 AUDIT_FAITHFUL=1 electron .",
    "electron:build": "tsc -b && ELECTRON_BUILD=1 vite build && npm run electron:compile && electron-builder --publish=never",
    "electron:build:win": "tsc -b && npx cross-env ELECTRON_BUILD=1 vite build && npm run electron:compile && electron-builder --win --publish=never",
    "size": "size-limit",
    "a11y": "npx tsx scripts/a11y-axe.mts",
    "a11y:pa11y": "pa11y-ci",
    "e2e": "playwright test",
    "knip": "knip",
    "lockfile:lint": "lockfile-lint",
    "bench": "vitest bench --run"
  },
  "size-limit": [
    {
      "path": "dist/assets/index-*.js",
      "brotli": true,
      "limit": "250 kB"
    },
    {
      "path": "dist/assets/three-*.js",
      "brotli": true,
      "limit": "150 kB"
    }
  ],
  "build": {
    "appId": "com.asap-australia.coh2-skin-editor",
    "productName": "CoH2 Skin Editor",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/steamworks.js/**/*",
      "native/coh2-workshop/package.json",
      "native/coh2-workshop/index.js",
      "native/coh2-workshop/index.d.ts",
      "native/coh2-workshop/bin/**/*",
      "native/coh2-workshop/build/Release/coh2_workshop.node",
      "steam_appid.txt"
    ],
    "extraResources": [
      {
        "from": "steam_appid.txt",
        "to": "../steam_appid.txt"
      }
    ],
    "asarUnpack": [
      "node_modules/steamworks.js/dist/**/*",
      "native/coh2-workshop/bin/**/*",
      "native/coh2-workshop/build/Release/*.node"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "public/asap-logo.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/asap-logo.png",
      "category": "Game"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/asap-logo.png"
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@types/three": "^0.184.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "pako": "^2.1.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "steamworks.js": "^0.4.0",
    "tailwind-merge": "^3.5.0",
    "three": "^0.184.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@size-limit/file": "^12.1.0",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^24.12.2",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "canvas": "^3.2.3",
    "concurrently": "^9.2.1",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fast-check": "^4.8.0",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "knip": "^6.14.2",
    "lockfile-lint": "^5.0.0",
    "pa11y-ci": "^4.1.1",
    "playwright": "^1.60.0",
    "shadcn": "^4.6.0",
    "size-limit": "^12.1.0",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.5"
  }
}
