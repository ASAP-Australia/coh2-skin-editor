{
  "permissions": {
    "deny": [
      "Bash(pkill -f *)",
      "Bash(pgrep -f *)",
      "Bash(killall *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-process-kill.sh"
          }
        ]
      }
    ]
  }
}
