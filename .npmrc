; eslint@10 is incompatible with the (current latest) eslint-plugin-jsx-a11y@6.10.2,
; whose peer range caps at eslint@9. The plugin works fine against eslint@10 at
; runtime, so we relax peer-dependency resolution rather than pin eslint back.
; This is a dev-tooling-only setting: it has zero effect on the shipped app /
; AppImage build output, only on how `npm ci` resolves the devDependency tree.
legacy-peer-deps=true
