node_modules
dist
dist-electron/electron/
release/

# Build / test artefacts that don't belong in git
coverage/
playwright-report/
test-results/
.lighthouseci/
reports/
out/
.vite/
node_modules/.vite/

# Compiled electron main-process output (regenerated by electron:compile).
# main.js / preload.js / package.json under here are tracked deliberately;
# everything else is generated and should stay out of git.
dist-electron/*.js
!dist-electron/main.js
!dist-electron/preload.js
dist-electron/*.html
dist-electron/__tests__/

# Diagnostic image/render dumps under artifacts/ (design-doc .md files there
# are tracked deliberately, so only ignore the generated images).
artifacts/**/*.png
artifacts/*.png

# Throwaway diagnostic / decode scripts (not part of the shipped tool)
tools/diag-*
tools/cdp-*
tools/uv-bakeoff*
tools/extract-tiger-verts-json.mts
scripts/make-decode-contact-sheet.js

# Editor / agent scratchpads
.llm/
.claude-conversations/

# Large local-only datasets — Tailwind v4 honours .gitignore for its
# auto-source scan, so this also stops `tailwindcss` from trying to
# walk these directories at build time. The `training/` directory
# alone is ~18 GB of ML weights and caches; without this entry
# `vite build` hung indefinitely in the transform stage as Tailwind
# attempted to extract class names from every file in that tree.
training/
tools/extracted/
tools/companion/

# Project artefacts users may produce locally
*.coh2skin
*.coh2skin.bak-*
sbom.cdx.json

# OS / IDE
.DS_Store
*.log
.env
.env.*
!.env.example

# Workshop / Steam upload caches
tools/templates/*.sga
tools/templates/signed/
public/keys/*.sga
public/keys/manifest.json
